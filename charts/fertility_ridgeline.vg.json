{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Five separated ridgeline profiles of age-specific fertility. Each profile has its own baseline and every profile uses the same height scale. The marks connect the seven published five-year age-group rates without estimating a continuous distribution. All points are hoverable; direct labels identify each profile’s peak rate.",
  "width": 930,
  "height": 500,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": {
    "left": 58,
    "right": 20,
    "top": 12,
    "bottom": 45
  },
  "background": "#fffefa",
  "config": {
    "font": "Source Sans 3",
    "axis": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "labelColor": "#526863",
      "titleColor": "#526863",
      "domain": false,
      "tickColor": "#cad5c9",
      "gridColor": "#e4e8df",
      "titleFontWeight": "normal",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "legend": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "labelColor": "#526863",
      "titleColor": "#526863",
      "titleFontWeight": "normal",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "text": {
      "font": "Source Sans 3"
    }
  },
  "signals": [
    {
      "name": "rowStep",
      "update": "height/5"
    }
  ],
  "data": [
    {
      "name": "profiles",
      "url": "Family_Life_Australia_Data/data/fertility_profiles.csv",
      "format": {
        "type": "csv",
        "parse": "auto"
      }
    }
  ],
  "scales": [
    {
      "name": "age",
      "type": "linear",
      "domain": [
        15,
        50
      ],
      "range": "width",
      "zero": false
    },
    {
      "name": "rateHeight",
      "type": "linear",
      "domain": [
        0,
        250
      ],
      "range": [
        0,
        {
          "signal": "rowStep * .80"
        }
      ],
      "zero": true
    }
  ],
  "axes": [
    {
      "scale": "age",
      "orient": "bottom",
      "title": "Mother’s age group",
      "values": [
        17.5,
        22.5,
        27.5,
        32.5,
        37.5,
        42.5,
        47.5
      ],
      "labelFontSize": 11,
      "labelPadding": 8,
      "encode": {
        "labels": {
          "update": {
            "text": {
              "signal": "datum.value===17.5 ? '15–19' : datum.value===22.5 ? '20–24' : datum.value===27.5 ? '25–29' : datum.value===32.5 ? '30–34' : datum.value===37.5 ? '35–39' : datum.value===42.5 ? '40–44' : '45–49'"
            }
          }
        }
      }
    }
  ],
  "marks": [
    {
      "type": "group",
      "from": {
        "facet": {
          "name": "profile",
          "data": "profiles",
          "groupby": "year"
        }
      },
      "encode": {
        "update": {
          "y": {
            "signal": "(indexof([1964,1984,2004,2014,2024],datum.year)+1)*rowStep - 6"
          }
        }
      },
      "marks": [
        {
          "type": "rule",
          "encode": {
            "update": {
              "x": {
                "value": 0
              },
              "x2": {
                "signal": "width"
              },
              "y": {
                "value": 0
              },
              "stroke": {
                "value": "#d9e2d7"
              },
              "strokeWidth": {
                "value": 1
              }
            }
          }
        },
        {
          "type": "area",
          "from": {
            "data": "profile"
          },
          "sort": {
            "field": "age_midpoint"
          },
          "encode": {
            "update": {
              "x": {
                "scale": "age",
                "field": "age_midpoint"
              },
              "y": {
                "signal": "-scale('rateHeight',datum.births_per_1000_women)"
              },
              "y2": {
                "value": 0
              },
              "fill": {
                "value": "#abcbbc"
              },
              "fillOpacity": {
                "value": 0.72
              },
              "stroke": {
                "value": "#317c70"
              },
              "strokeWidth": {
                "value": 1.7
              }
            }
          }
        },
        {
          "type": "symbol",
          "from": {
            "data": "profile"
          },
          "encode": {
            "update": {
              "x": {
                "scale": "age",
                "field": "age_midpoint"
              },
              "y": {
                "signal": "-scale('rateHeight',datum.births_per_1000_women)"
              },
              "size": {
                "value": 34
              },
              "fill": {
                "value": "#fffefa"
              },
              "stroke": {
                "value": "#226b64"
              },
              "opacity": {
                "value": 1
              },
              "tooltip": {
                "signal": "{'Year':datum.year,'Age group':datum.age_group,'Births per 1,000 women':format(datum.births_per_1000_women,'.1f'),'Period total fertility':format(datum.total_fertility_rate,'.3f')}"
              },
              "strokeWidth": {
                "value": 1.5
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "value": -10
              },
              "y": {
                "signal": "-rowStep*.23"
              },
              "align": {
                "value": "right"
              },
              "baseline": {
                "value": "middle"
              },
              "text": {
                "signal": "parent.year"
              },
              "fill": {
                "value": "#163b3d"
              },
              "fontSize": {
                "value": 13
              },
              "fontWeight": {
                "value": "bold"
              }
            }
          }
        },
        {
          "type": "text",
          "from": {
            "data": "peak"
          },
          "encode": {
            "update": {
              "x": {
                "scale": "age",
                "field": "age_midpoint"
              },
              "y": {
                "signal": "-scale('rateHeight',datum.births_per_1000_women) - 9"
              },
              "text": {
                "signal": "format(datum.births_per_1000_women,'.1f') + (datum.year===1964 || datum.year===2024 ? ' · ages '+replace(datum.age_group,'-','–') : '')"
              },
              "align": {
                "value": "center"
              },
              "baseline": {
                "value": "bottom"
              },
              "fontSize": {
                "value": 11
              },
              "fontWeight": {
                "value": "bold"
              },
              "fill": {
                "value": "#245e57"
              }
            }
          }
        }
      ],
      "data": [
        {
          "name": "peak",
          "source": "profile",
          "transform": [
            {
              "type": "joinaggregate",
              "ops": [
                "max"
              ],
              "fields": [
                "births_per_1000_women"
              ],
              "as": [
                "peak_rate"
              ]
            },
            {
              "type": "filter",
              "expr": "datum.births_per_1000_women === datum.peak_rate"
            }
          ]
        }
      ]
    }
  ]
}
