{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Dorling population cartogram of 88 SA4 regions, with a separate geographic reference map. Circle area represents 2024 population and colour represents fertility decline. Circle positions are displaced to avoid overlap. The reference map retains true geography and highlights the selected region in gold, using the original geographic anchors. Circle sizes and positions use one common scale factor.",
  "width": 930,
  "height": 620,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": {
    "left": 12,
    "right": 12,
    "top": 10,
    "bottom": 12
  },
  "background": "#fffefa",
  "config": {
    "font": "Source Sans 3",
    "axis": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "labelColor": "#526863",
      "titleColor": "#526863",
      "domain": false,
      "tickColor": "#cad5c9",
      "gridColor": "#e4e8df",
      "titleFontWeight": "normal",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "legend": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "labelColor": "#526863",
      "titleColor": "#526863",
      "titleFontWeight": "normal",
      "layout": {
        "bottom": {
          "direction": "vertical",
          "margin": 12,
          "anchor": "start"
        }
      },
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "text": {
      "font": "Source Sans 3"
    }
  },
  "signals": [
    {
      "name": "region",
      "value": ""
    },
    {
      "name": "sideReference",
      "update": "width >= 760"
    },
    {
      "name": "referenceWidth",
      "update": "sideReference ? min(230, width*.24) : 150"
    },
    {
      "name": "cartogramWidth",
      "update": "sideReference ? width-referenceWidth-28 : width"
    },
    {
      "name": "cartogramHeight",
      "update": "cartogramWidth*.65"
    },
    {
      "name": "cartogramTop",
      "update": "sideReference ? 12 : 200"
    },
    {
      "name": "referenceScale",
      "update": "(referenceWidth-10)/637.0744924998742"
    },
    {
      "name": "referenceX",
      "update": "sideReference ? cartogramWidth+28 : 8"
    }
  ],
  "data": [
    {
      "name": "regions",
      "url": "assets/sa4_cartogram_layout.json",
      "format": {
        "type": "json"
      }
    },
    {
      "name": "coastline",
      "url": "assets/sa4_cartogram_outline.json",
      "format": {
        "type": "json"
      }
    },
    {
      "name": "selectedRegion",
      "source": "regions",
      "transform": [
        {
          "type": "filter",
          "expr": "region !== '' && datum.sa4_code_2021 === region"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "cartX",
      "type": "linear",
      "domain": [
        0,
        1000
      ],
      "range": [
        0,
        {
          "signal": "cartogramWidth"
        }
      ],
      "zero": true
    },
    {
      "name": "cartY",
      "type": "linear",
      "domain": [
        0,
        650
      ],
      "range": [
        {
          "signal": "cartogramTop"
        },
        {
          "signal": "cartogramTop+cartogramHeight"
        }
      ],
      "zero": true
    },
    {
      "name": "decline",
      "type": "linear",
      "domain": [
        0,
        0.7
      ],
      "range": [
        "#e9f1e5",
        "#185b59"
      ],
      "zero": true
    },
    {
      "name": "populationArea",
      "type": "linear",
      "domain": [
        0,
        1000000
      ],
      "range": [
        0,
        {
          "signal": "4*0.0024911017301057718/PI*1000000*pow(cartogramWidth/1000,2)"
        }
      ],
      "zero": true
    }
  ],
  "legends": [
    {
      "fill": "decline",
      "title": "Fall in births per woman",
      "orient": "bottom",
      "direction": "horizontal",
      "gradientLength": 180,
      "values": [
        0,
        0.2,
        0.4,
        0.6
      ],
      "format": ".1f",
      "titleLimit": 230
    },
    {
      "size": "populationArea",
      "title": "2024 population (circle area)",
      "orient": "bottom",
      "direction": "horizontal",
      "values": [
        200000,
        500000,
        1000000
      ],
      "format": "~s",
      "symbolType": "circle",
      "symbolStrokeColor": "#526863",
      "symbolFillColor": "transparent",
      "titleLimit": 260
    }
  ],
  "marks": [
    {
      "type": "symbol",
      "from": {
        "data": "regions"
      },
      "encode": {
        "update": {
          "x": {
            "scale": "cartX",
            "field": "cartogram_x"
          },
          "y": {
            "scale": "cartY",
            "field": "cartogram_y"
          },
          "shape": {
            "value": "circle"
          },
          "size": {
            "scale": "populationArea",
            "field": "population_2024_count"
          },
          "fill": {
            "scale": "decline",
            "field": "fertility_decline"
          },
          "stroke": {
            "signal": "region!=='' && datum.sa4_code_2021===region ? '#ad6819' : '#fffefa'"
          },
          "strokeWidth": {
            "signal": "region!=='' && datum.sa4_code_2021===region ? 3 : .8"
          },
          "tooltip": {
            "signal": "{'SA4':datum.sa4_name,'Code':datum.sa4_code_2021,'2024 population':format(datum.population_2024_count,','),'2013 fertility (3yr average)':format(datum.tfr_start_3yr_average,'.2f'),'2024 fertility (3yr average)':format(datum.tfr_end_3yr_average,'.2f'),'Fall in births per woman':format(datum.fertility_decline,'.2f')}"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "regions"
      },
      "encode": {
        "update": {
          "x": {
            "scale": "cartX",
            "field": "cartogram_x"
          },
          "y": {
            "scale": "cartY",
            "field": "cartogram_y"
          },
          "text": {
            "field": "sa4_code_2021"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "fontSize": {
            "signal": "width<500 ? 7 : 9"
          },
          "fill": {
            "signal": "datum.fertility_decline>.4 ? '#ffffff' : '#254e49'"
          },
          "opacity": {
            "signal": "width>500 && datum.cartogram_radius>16 ? 1 : 0"
          }
        }
      }
    },
    {
      "type": "group",
      "name": "geographicReference",
      "encode": {
        "update": {
          "x": {
            "signal": "referenceX"
          },
          "y": {
            "value": 18
          },
          "width": {
            "signal": "referenceWidth"
          },
          "height": {
            "value": 240
          }
        }
      },
      "marks": [
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "value": 0
              },
              "y": {
                "value": 0
              },
              "text": {
                "value": "Geographic reference"
              },
              "fontSize": {
                "value": 11
              },
              "fontWeight": {
                "value": "bold"
              },
              "fill": {
                "value": "#526863"
              }
            }
          }
        },
        {
          "type": "path",
          "from": {
            "data": "coastline"
          },
          "interactive": false,
          "encode": {
            "update": {
              "x": {
                "signal": "-144.66766444423274*referenceScale"
              },
              "y": {
                "signal": "20-14.62858136624925*referenceScale"
              },
              "path": {
                "field": "path"
              },
              "scaleX": {
                "signal": "referenceScale"
              },
              "scaleY": {
                "signal": "referenceScale"
              },
              "fill": {
                "value": "#edf0e8"
              },
              "stroke": {
                "value": "#8b9f98"
              },
              "strokeWidth": {
                "value": 1.3
              }
            }
          }
        },
        {
          "type": "symbol",
          "from": {
            "data": "selectedRegion"
          },
          "encode": {
            "update": {
              "x": {
                "signal": "(datum.anchor_x-144.66766444423274)*referenceScale"
              },
              "y": {
                "signal": "20+(datum.anchor_y-14.62858136624925)*referenceScale"
              },
              "shape": {
                "value": "circle"
              },
              "size": {
                "value": 55
              },
              "fill": {
                "value": "#ad6819"
              },
              "stroke": {
                "value": "#fffefa"
              },
              "strokeWidth": {
                "value": 1.5
              },
              "tooltip": {
                "signal": "{'Original map location':datum.sa4_name}"
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "signal": "sideReference ? 0 : referenceWidth+14"
              },
              "y": {
                "signal": "sideReference ? 38+589.0419781180009*referenceScale : 44"
              },
              "text": {
                "signal": "region === '' ? ['Select a region','to locate it here.'] : ['Gold marks the','selected region.']"
              },
              "fontSize": {
                "value": 10
              },
              "fill": {
                "value": "#526863"
              },
              "limit": {
                "signal": "sideReference ? referenceWidth : max(125,width-referenceWidth-30)"
              },
              "lineHeight": {
                "value": 15
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "signal": "sideReference ? 0 : referenceWidth+14"
              },
              "y": {
                "signal": "sideReference ? 82+589.0419781180009*referenceScale : 88"
              },
              "text": {
                "value": "Circles show population."
              },
              "fontSize": {
                "value": 10
              },
              "fill": {
                "value": "#526863"
              }
            }
          }
        }
      ]
    }
  ]
}
